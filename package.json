{
  "name": "docs-site",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start --port 3004",
    "prebuild": "node scripts/check-blog-filenames.mjs && node scripts/check-blog-en-mirrors.mjs",
    "prebuild:zh": "node scripts/check-blog-filenames.mjs && node scripts/check-blog-en-mirrors.mjs",
    "prebuild:ai": "node scripts/check-blog-filenames.mjs && node scripts/check-blog-en-mirrors.mjs",
    "build": "docusaurus build",
    "build:zh": "cp static/robots.zh.txt static/robots.txt && cp static/llm.zh.txt static/llm.txt && SITE=zh docusaurus build",
    "build:ai": "cp static/robots.ai.txt static/robots.txt && cp static/llm.ai.txt static/llm.txt && SITE=ai docusaurus build",
    "build:with-api": "sed -i \"s|__RAG_API_URL__|$RAG_API_URL|g\" src/rag-api-config.js && docusaurus build && git checkout src/rag-api-config.js",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids"
  },
  "dependencies": {
    "@docusaurus/core": "^3.9.0",
    "@docusaurus/preset-classic": "^3.9.0",
    "@docusaurus/theme-mermaid": "^3.9.2",
    "@mdx-js/react": "^3.0.0",
    "dotenv": "^17.2.4",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.563.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@docusaurus/faster": "^3.9.2",
    "@docusaurus/module-type-aliases": "^3.9.0",
    "@docusaurus/tsconfig": "^3.9.0",
    "@docusaurus/types": "^3.9.0",
    "@tailwindcss/typography": "^0.5.19",
    "autoprefixer": "^10.4.24",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.7.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  }
}
